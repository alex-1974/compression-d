name "compression-d"
description "D-native, allocation-controlled compression and decompression codecs"
license "BSD-3-Clause"
authors "d-geospatial-workspace"
targetType "library"
sourcePaths "source"
importPaths "source"
targetPath ".build"

configuration "library" {
    targetType "library"
}

configuration "unittest" {
    targetType "executable"
    sourcePaths "source" "tests"
    mainSourceFile "tests/primitives_probe.d"
    excludedSourceFiles "tests/core_probe.d" "tests/inflate_probe.d" "tests/framing_probe.d"
}
